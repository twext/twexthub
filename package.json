{
  "name": "@twext/twexthub",
  "version": "0.4.0",
  "private": true,
  "description": "A lightweight registry of Twext-compiled extensions (\"Twexts\") for use in TurboWarp",
  "homepage": "https://github.com/twext/twexthub#readme",
  "bugs": {
    "url": "https://github.com/twext/twexthub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twext/twexthub.git"
  },
  "license": "Apache-2.0",
  "author": "Twext Team",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:setup": "bash -c 'if docker ps >/dev/null 2>&1 && [ \"$(docker ps --format \"{{.Names}}\" | grep -x twexthub-pg)\" ]; then CMD=\"docker exec twexthub-pg\"; else CMD=\"\"; fi; $CMD createdb -U postgres twexthub_test 2>/dev/null || true'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctoc": "doctoc --notitle README.md",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "postgres": "^3.4.7",
    "semver": "^7.7.2",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "doctoc": "^2.5.0",
    "eslint": "^10.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2"
  }
}
